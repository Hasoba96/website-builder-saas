{
  "name": "website-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.21.0",
    "pnpm": "10.34.6"
  },
  "scripts": {
    "ci:verify": "node scripts/ci.ts verify",
    "ci:images": "node scripts/ci.ts images",
    "ci:validate": "node scripts/ci-policy.ts",
    "ci:supply-chain": "node scripts/ci-supply-chain.ts",
    "ci:budget": "node scripts/ci-budget.ts",
    "infra": "node scripts/infra.ts",
    "test:local": "node scripts/test-local.ts",
    "test:images": "node scripts/test-images.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && pnpm boundaries:check",
    "typecheck": "tsc --noEmit && node scripts/turbo.ts run typecheck",
    "test": "node scripts/test-all.ts",
    "test:redis": "node scripts/test-redis.ts",
    "test:browser": "playwright test",
    "test:database": "node scripts/test-database.ts",
    "test:backup": "node scripts/test-database.ts --backup",
    "db:migrate": "node --env-file-if-exists=.env.migration scripts/migrate.ts",
    "dev": "node scripts/turbo.ts run dev",
    "boundaries:check": "node scripts/turbo.ts run build --filter=./packages/* && node scripts/check-boundaries.ts",
    "build": "node scripts/turbo.ts run build",
    "workspace:check": "node scripts/turbo.ts ls --output=json",
    "lint:workspaces": "node scripts/turbo.ts run lint",
    "typecheck:workspaces": "node scripts/turbo.ts run typecheck",
    "security:dependencies": "pnpm audit --audit-level high",
    "security:secrets": "node scripts/scan-secrets.ts",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "devDependencies": {
    "@actions/artifact": "6.3.1",
    "@vitest/coverage-v8": "5.0.3",
    "@website-builder/observability": "workspace:*",
    "@website-builder/schemas": "workspace:*",
    "@website-builder/queues": "workspace:*",
    "ioredis": "6.0.0",
    "@website-builder/database": "workspace:*",
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "node-pg-migrate": "9.0.0",
    "@next/env": "16.4.1",
    "@website-builder/config": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "jiti": "2.7.0",
    "prettier": "3.9.9",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "playwright-core": "1.63.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
