# Local development only. Listener exposes operational probes, never product endpoints.
NODE_ENV=development
APP_ENV=local
# Exact hostnames (no ports/wildcards) and origins. Empty CORS denies cross-origin.
HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
HTTP_CORS_ORIGINS=
# Current surfaces reject all bodies before parsing; cap also rejects oversized declarations.
HTTP_BODY_MAX_BYTES=16384
HTTP_RATE_LIMIT=600
HTTP_RATE_WINDOW_MS=60000
SHUTDOWN_TIMEOUT_MS=10000
READINESS_TIMEOUT_MS=1000
PROBE_HOST=127.0.0.1
PROBE_PORT=3004
# Required Redis connectivity; no production queues are registered in 00-E.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=worker
REDIS_PASSWORD=REPLACE_ME
REDIS_TLS=disable
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=2000
REDIS_OUTAGE_TIMEOUT_MS=10000
REDIS_RECONNECT_LIMIT=5
REDIS_RECONNECT_DELAY_MS=200
