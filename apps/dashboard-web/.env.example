# Next chooses NODE_ENV by command; never set NODE_ENV=staging.
APP_ENV=local
# Exact hostnames (no ports/wildcards) and origins. Empty CORS denies cross-origin.
HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Operator-owned absolute redirect origin. Never inferred from request headers.
HTTP_CANONICAL_ORIGIN=http://127.0.0.1:3000
HTTP_CORS_ORIGINS=
# Current surfaces reject all bodies before parsing; cap also rejects oversized declarations.
HTTP_BODY_MAX_BYTES=16384
HTTP_RATE_LIMIT=600
HTTP_RATE_WINDOW_MS=60000
HOST=127.0.0.1
PORT=3000
# No NEXT_PUBLIC_* keys are allowlisted in checkpoint 00-C.
