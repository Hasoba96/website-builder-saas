# Local development only. Process environment takes precedence.
NODE_ENV=development
APP_ENV=local
# Exact hostnames (no ports/wildcards) and origins. Empty CORS denies cross-origin.
HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
HTTP_CORS_ORIGINS=
# Current surfaces reject all bodies before parsing; cap also rejects oversized declarations.
HTTP_BODY_MAX_BYTES=16384
HTTP_RATE_LIMIT=600
HTTP_RATE_WINDOW_MS=60000
HOST=127.0.0.1
PORT=3001
SHUTDOWN_TIMEOUT_MS=10000
READINESS_TIMEOUT_MS=1000
# Runtime credentials only. Never place migration credentials in this file.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=foundation
DB_USER=wb_runtime
DB_PASSWORD=REPLACE_ME
# Plaintext is accepted only for loopback local/ci. All deployments require verify-full.
DB_TLS=disable
# DB_CA=PEM certificate authority (optional with verify-full; system trust otherwise)
DB_POOL_MAX=2
DB_CONNECT_TIMEOUT_MS=1000
DB_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=6000
DB_LOCK_TIMEOUT_MS=1000
