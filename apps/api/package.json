{
  "name": "@website-builder/api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/main.js"
  },
  "dependencies": {
    "@website-builder/observability": "workspace:*",
    "@website-builder/database": "workspace:*",
    "@website-builder/config": "workspace:*",
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@nestjs/platform-express": "12.1.1"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.1"
  }
}
