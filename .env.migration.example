# Operator-only. Copy to .env.migration locally; never share with application processes.
NODE_ENV=development
APP_ENV=local
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=foundation
MIGRATION_DB_USER=wb_migrator
MIGRATION_DB_PASSWORD=REPLACE_ME
DB_TLS=disable
# DB_CA=PEM certificate authority (optional with verify-full; system trust otherwise)
DB_CONNECT_TIMEOUT_MS=1000
DB_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=6000
DB_LOCK_TIMEOUT_MS=1000
